# ==========================================
# UniStore Root Git Ignore
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!*.env.example

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Node & Frontend dependencies and builds
node_modules/
dist/
dist-ssr/
build/
.output/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# Mobile (Android & iOS / Capacitor)
*.apk
*.aab
frontend/public/*.apk
frontend/android/.gradle/
frontend/android/build/
frontend/android/app/build/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/*.iml
frontend/android/app/*.iml
frontend/ios/App/Pods/
frontend/ios/App/build/
frontend/ios/App/DerivedData/
frontend/ios/App/.symlinks/
frontend/ios/App/Pods.xcodeproj
frontend/ios/App/App.xcworkspace/xcuserdata/
frontend/ios/App/App.xcodeproj/xcuserdata/
frontend/ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/

# IDE and Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
